{
  "name": "cadence",
  "private": true,
  "version": "0.0.0",
  "description": "AI-powered, cross-platform music creation studio (working codename).",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "lint": "npm run lint --workspace @cadence/web",
    "typecheck": "npm run typecheck --workspace @cadence/web",
    "build": "npm run build --workspace @cadence/web",
    "test": "npm run test --workspace @cadence/web",
    "test:coverage": "npm run test:coverage --workspace @cadence/web",
    "e2e": "npm run e2e --workspace @cadence/web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimist": "1.2.8",
    "protobufjs": "7.6.5"
  }
}
