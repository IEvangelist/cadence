<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Scalar interactive API reference UI over the OpenAPI document. -->
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- Aspire client integration: wires the Npgsql DbContext to the "cadencedb"
         resource with health checks, telemetry, and connection resilience. -->
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Aspire client integration: wires the Blob service client to the "blobs"
         resource (Azurite in development) for mix/stem storage. -->
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <!-- Aspire client integration: registers IConnectionMultiplexer wired to the
         "redis" resource, backing the auth rate limiters with a distributed store. -->
    <PackageReference Include="Aspire.StackExchange.Redis" />
    <!-- Community Toolkit Ollama client integration: registers an IChatClient bound
         to the "ollama-model" resource for the optional server-side AI endpoint (#140).
         Resolved only when Ai:ServerSide:Enabled and the model connection is present. -->
    <PackageReference Include="CommunityToolkit.Aspire.OllamaSharp" />
    <!-- External OAuth providers. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" />
    <PackageReference Include="AspNet.Security.OAuth.GitHub" />
    <!-- Billing provider (Stripe, test mode). -->
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Data\Cadence.Data.csproj" />
    <ProjectReference Include="..\Cadence.ServiceDefaults\Cadence.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
