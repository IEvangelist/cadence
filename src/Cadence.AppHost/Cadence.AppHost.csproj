<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>3961be16-eb97-4a53-a5ba-f83676fcd284</UserSecretsId>
    <!--
      The Aspire AppHost SDK injects host-RID-specific Dashboard and
      Orchestration packages (e.g. Aspire.Dashboard.Sdk.win-x64 vs
      .linux-x64) into the base target of packages.lock.json, keyed to the
      restoring machine's SDK runtime identifier. A single committed lock file
      therefore cannot satisfy a locked restore on every OS, so this project
      opts out of locked mode. Its dependencies remain exact-pinned via Central
      Package Management, and the lock file is still committed for auditing.
    -->
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Azure.Redis" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.NodeJs" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Api\Cadence.Api.csproj" />
    <ProjectReference Include="..\Cadence.SeparationWorker\Cadence.SeparationWorker.csproj" />
  </ItemGroup>

</Project>
