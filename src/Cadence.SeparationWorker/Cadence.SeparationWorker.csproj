<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A generic worker host that still uses ASP.NET Core health-check types via
         the shared ServiceDefaults; the framework reference brings those in. -->
    <UserSecretsId>b2b9a4e6-1c3d-4a5f-9e7c-8d0a1b2c3d4e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Global usings the Worker SDK would supply; this project uses the base SDK
       (no inbound HTTP) but still hosts a BackgroundService and DI. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire client integration: binds the Npgsql DbContext to "cadencedb". -->
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Aspire client integration: binds the Blob service client to "blobs". -->
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <!-- ONNX Runtime (CPU) for the Demucs stem-separation model. GPU is used when
         a CUDA provider is available at runtime, with an automatic CPU fallback. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Data\Cadence.Data.csproj" />
    <ProjectReference Include="..\Cadence.ServiceDefaults\Cadence.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
