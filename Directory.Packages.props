<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Aspire hosting integrations">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.4.6" />
    <!-- Redis client integration: registers IConnectionMultiplexer wired to the
         "redis" resource, used to back the auth rate limiters with a distributed
         (cross-replica) fixed-window store. Pulls StackExchange.Redis transitively. -->
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.4.6" />
    <!--
      Node.js hosting integration (AddNpmApp) for the apps/web dev server. The
      curated feed publishes this package only up to 9.5.2 (the core Aspire
      hosting packages are 13.4.6); 9.5.2 is the latest available stable and its
      npm-app surface binds cleanly against the 13.4.6 host — verified by a live
      `aspire run` smoke (the web resource starts Vite and serves the SPA).
    -->
    <PackageVersion Include="Aspire.Hosting.NodeJs" Version="9.5.2" />
  </ItemGroup>

  <ItemGroup Label="Stem separation (Blob storage, ONNX Runtime)">
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.4.6" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup Label="Data &amp; persistence (EF Core, Identity, Npgsql)">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!--
      Transitive pin: Microsoft.EntityFrameworkCore.Sqlite 10.0.10 pulls in
      SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries GHSA-2m69-gcr7-jv3q
      (NU1903, high severity: vulnerable bundled SQLite; affects <= 2.1.11).
      2.1.12 is the lowest release outside the advisory range. Pinned exactly,
      forced up via CentralPackageTransitivePinningEnabled.
    -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
  </ItemGroup>

  <ItemGroup Label="Authentication (external OAuth providers)">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.10" />
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Service defaults (telemetry, resilience, discovery)">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Transitive pin: Microsoft.AspNetCore.OpenApi 10.0.10 pulls in
      Microsoft.OpenApi 2.0.0, which carries GHSA-v5pm-xwqc-g5wc (NU1903,
      high severity: stack overflow on circular schema refs). 2.7.5 is the
      lowest patched release on the 2.x line. Pinned exactly, forced up via
      CentralPackageTransitivePinningEnabled.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Scalar: human-facing interactive API reference UI rendered over the
         OpenAPI document. net10.0 target carries no package dependencies. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.18" />
  </ItemGroup>

  <ItemGroup Label="Billing (Stripe)">
    <PackageVersion Include="Stripe.net" Version="52.2.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
  </ItemGroup>

</Project>
