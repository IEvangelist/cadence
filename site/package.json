{
  "name": "@cadence/site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cadence marketing landing page + documentation site. Standalone Astro project — NOT part of the root npm workspaces, so it never touches the apps/web dependency tree or the root lockfile. Deployed to GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:preflight": "node scripts/check-preflight.mjs",
    "test": "npm run check:preflight && playwright test",
    "test:install": "playwright install --with-deps chromium",
    "verify": "astro build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/react": "6.0.2",
    "astro": "7.2.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "axe-core": "4.13.0",
    "tailwindcss": "4.3.3"
  }
}
