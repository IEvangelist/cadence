{
  "name": "@cadence/site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cadence marketing landing page + documentation site. Standalone Astro project — NOT part of the root npm workspaces, so it never touches the apps/web dependency tree or the root lockfile. Deployed to GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:licenses": "node scripts/check-runtime-notices.mjs",
    "check:preflight": "node scripts/check-preflight.mjs && npm run check:licenses",
    "test": "npm run check:preflight && playwright test",
    "test:install": "playwright install --with-deps chromium",
    "verify": "astro build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "astro": "7.4.1",
    "motion": "14.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
