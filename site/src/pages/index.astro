---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LandingMotion from '../components/LandingMotion';
import { href } from '../lib/href';

const repo = 'https://github.com/IEvangelist/cadence';
const releases = `${repo}/releases`;

// Product media is copied from the authoritative Linux Chromium baselines in
// apps/web/e2e/final-gate/__screenshots__. Reproduce it with apps/web's
// `npm run e2e:visual`; these are product captures, not marketing mockups.
const formats = ['MIDI', 'MusicXML', 'WAV', 'MP3', '.cadence.json'];

const plans = [
  {
    name: 'Free',
    price: '$0',
    cadence: 'forever',
    description: 'A complete place to start writing music.',
    features: [
      'Up to 10 saved projects',
      'Composer, piano roll, mixer, and playback',
      '50 on-device AI generations each day',
      'MIDI, MusicXML, WAV, and MP3 export',
      'Shareable listen links',
    ],
  },
  {
    name: 'Pro',
    price: '$12',
    cadence: 'per month',
    description: 'More room to create, collaborate, and export.',
    features: [
      'Unlimited projects and AI generations',
      'Watermark-free audio exports',
      'Stem separation',
      'Up to 5 collaboration seats',
      'Priority updates',
    ],
  },
];

const faq = [
  {
    question: 'Does the AI upload my music?',
    answer:
      'No. Cadence AI generation runs on your device today, so ideas stay local and keep working offline.',
  },
  {
    question: 'What can I import and export?',
    answer:
      'Cadence round-trips MIDI and MusicXML, exports WAV and MP3, and saves portable .cadence.json project files.',
  },
  {
    question: 'Can people edit a project together?',
    answer:
      'Yes. Paid collaboration uses owner, editor, and viewer roles with conflict-free real-time sync.',
  },
  {
    question: 'Can I self-host Cadence?',
    answer:
      'Yes. The backend is modeled with Aspire and can be deployed to Azure Container Apps with azd.',
  },
  {
    question: 'Is pricing final?',
    answer:
      'The Free plan stays free. The paid price shown here is indicative while Cadence remains in active development.',
  },
];

const description =
  'Cadence is an open, cross-platform music studio with on-device AI, a fast piano roll, live collaboration, stems, and portable exports.';
---

<BaseLayout title="Cadence" description={description}>
  <LandingMotion client:load />

  <section class="landing-hero relative overflow-hidden">
    <div class="hero-orbit hero-orbit--one" aria-hidden="true"></div>
    <div class="hero-orbit hero-orbit--two" aria-hidden="true"></div>

    <div class="container hero-grid grid grid-cols-1 items-center gap-10 lg:grid-cols-[0.82fr_1.18fr]">
      <div class="hero-copy">
        <p class="hero-hook" data-hero-reveal>Every idea, resolved.</p>
        <h1 data-hero-reveal>Make the idea land.</h1>
        <p class="hero-lede" data-hero-reveal>
          Write, shape, and share music in one open studio, with on-device AI beside you.
        </p>
        <div class="hero-actions" data-hero-reveal>
          <a
            class="btn btn-primary"
            data-interaction="hero.download"
            href="#download"
          >
            <Icon name="download" size={20} />
            Download
          </a>
          <a
            class="btn btn-secondary"
            data-interaction="hero.docs"
            href={href('/docs/')}
          >
            <Icon name="book" size={20} />
            Docs
          </a>
        </div>
      </div>

      <figure class="hero-media" data-hero-reveal>
        <div class="media-frame">
          <img
            src={href('/screenshots/studio-write-default.png')}
            width="1440"
            height="900"
            alt="Cadence Write view with three tracks, transport controls, a piano roll, and velocity editing."
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <figcaption>A real capture of Cadence in Write view.</figcaption>
      </figure>
    </div>
  </section>

  <section id="features" class="studio-story">
    <div class="container">
      <div class="story-intro" data-reveal>
        <h2>Stay in the musical moment.</h2>
        <p>
          Cadence keeps writing, arranging, mixing, and sharing in one focused
          workspace, so the tool never outruns the idea.
        </p>
      </div>

      <div class="story-line" data-reveal>
        <article>
          <span class="story-icon"><Icon name="piano" size={24} /></span>
          <h3>Write at full speed</h3>
          <p>Shape notes on a responsive piano roll with transport, quantize, velocity, and automation close at hand.</p>
        </article>
        <article>
          <span class="story-icon"><Icon name="sliders" size={24} /></span>
          <h3>Move into the mix</h3>
          <p>Balance tracks, add effects, automate changes, and keep the same project moving from sketch to playback.</p>
        </article>
        <article>
          <span class="story-icon"><Icon name="share" size={24} /></span>
          <h3>Let the work travel</h3>
          <p>Save portable projects, export standard formats, or send a listen link without rebuilding the session.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ai-story">
    <div class="container ai-grid grid grid-cols-1 items-center gap-10 md:grid-cols-[1.08fr_0.92fr]">
      <figure class="product-media product-media--ai" data-reveal>
        <img
          src={href('/screenshots/ai-basic-suggestion.png')}
          width="1440"
          height="900"
          alt="Cadence AI Assistant suggesting melody notes beside the piano roll."
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="ai-copy" data-reveal>
        <span class="section-symbol" aria-hidden="true"><Icon name="sparkles" size={28} /></span>
        <h2>AI that joins the session.</h2>
        <p>
          Continue a melody, generate a fresh phrase, or harmonize what is
          already there. Inference runs on your device today.
        </p>
        <a class="text-link" href={href('/docs/features/')}>
          Explore AI in the docs
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="workflow">
    <div class="container">
      <div class="workflow-heading" data-reveal>
        <h2>One project, many ways forward.</h2>
        <p>
          Work in the view the track needs, then move it into tools other musicians already use.
        </p>
      </div>

      <div class="workflow-grid grid grid-cols-1 gap-5 md:grid-cols-[1.25fr_0.75fr]">
        <figure class="product-media product-media--mix" data-reveal>
          <img
            src={href('/screenshots/studio-mix.png')}
            width="1440"
            height="900"
            alt="Cadence Mix view with track gain, pan, effects, automation, and master bus controls."
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="format-panel" data-reveal>
          <span class="section-symbol" aria-hidden="true"><Icon name="interop" size={28} /></span>
          <h3>Open formats in. Open formats out.</h3>
          <p>
            Cadence fits an existing music workflow instead of trapping the project inside one app.
          </p>
          <ul class="format-list" aria-label="Supported formats">
            {formats.map((format) => <li>{format}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="open-story">
    <div class="container open-grid grid grid-cols-1 gap-8 md:grid-cols-[0.72fr_1.28fr]">
      <div class="open-lead" data-reveal>
        <span class="section-symbol" aria-hidden="true"><Icon name="puzzle" size={28} /></span>
        <h2>Open by design.</h2>
        <p>
          Extend the studio, run it locally, or deploy the service graph yourself.
        </p>
      </div>

      <div class="open-paths" data-reveal>
        <a href={href('/docs/plugin-sdk/')}>
          <span>
            <strong>Build on the Plugin SDK</strong>
            Add instruments, effects, formats, commands, AI providers, and panels through typed seams.
          </span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={href('/docs/self-hosting/')}>
          <span>
            <strong>Self-host the backend</strong>
            Run the Aspire model locally or publish its services to Azure Container Apps.
          </span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={repo} rel="noopener">
          <span>
            <strong>Read the source</strong>
            Inspect the MIT-licensed code, follow development, and contribute on GitHub.
          </span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section id="pricing" class="pricing-story">
    <div class="container">
      <div class="pricing-heading" data-reveal>
        <h2>Start with the whole instrument.</h2>
        <p>
          Free is a working studio. Pro removes limits, unlocks stems, and adds room for collaboration.
        </p>
      </div>

      <div class="plans-grid grid grid-cols-1 gap-5 md:grid-cols-[0.82fr_1.18fr]">
        {
          plans.map((plan, index) => (
            <article class:list={['plan-card', index === 1 && 'plan-card--pro']} data-reveal>
              <div class="plan-heading">
                <h3>{plan.name}</h3>
                <p class="plan-price">
                  <span>{plan.price}</span>
                  {plan.cadence}
                </p>
              </div>
              <p class="plan-description">{plan.description}</p>
              <ul>
                {plan.features.map((feature) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="pricing-note" data-reveal>
        The Free plan stays free. Paid pricing is indicative during active development.
      </p>
    </div>
  </section>

  <section class="faq-story">
    <div class="container faq-grid grid grid-cols-1 gap-10 md:grid-cols-[0.72fr_1.28fr]">
      <div class="faq-heading" data-reveal>
        <h2>Before you press play.</h2>
        <p>Practical answers, backed by the product and its documentation.</p>
      </div>

      <div class="faq-list" data-reveal>
        {
          faq.map((item, index) => (
            <details open={index === 0}>
              <summary data-interaction="faq.toggle">
                <span>{item.question}</span>
                <span class="faq-plus" aria-hidden="true">+</span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="download" class="download-story">
    <div class="container">
      <div class="download-panel" data-reveal>
        <div>
          <h2>Give the idea somewhere to land.</h2>
          <p>Get the latest Cadence build, or explore the source before you begin.</p>
        </div>
        <div class="download-actions">
          <a
            class="btn btn-on-brand"
            data-interaction="download.release"
            href={releases}
            rel="noopener"
          >
            <Icon name="download" size={20} />
            Download
          </a>
          <a
            class="btn btn-on-brand-secondary"
            data-interaction="download.github"
            href={repo}
            rel="noopener"
          >
            <Icon name="github" size={20} />
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .landing-hero {
    display: flex;
    align-items: center;
    min-height: calc(100dvh - 4.5rem);
    padding-block: clamp(var(--space-10), 7vw, var(--space-20));
    isolation: isolate;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
  }

  .hero-copy {
    max-width: 34rem;
  }

  .hero-hook {
    margin-bottom: var(--space-5);
    color: var(--color-accent-text);
    font-family: var(--font-display);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
  }

  .hero-copy h1 {
    max-width: 10ch;
    font-size: clamp(3.4rem, 7vw, 6rem);
    line-height: 0.92;
    text-wrap: balance;
  }

  .hero-lede {
    max-width: 31rem;
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: clamp(var(--font-size-md), 2vw, var(--font-size-xl));
  }

  .hero-actions,
  .download-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero-media {
    position: relative;
    margin: 0;
  }

  .hero-media::before {
    content: '';
    position: absolute;
    inset: 12% -4% -8% 18%;
    z-index: -1;
    border-radius: var(--radius-xl);
    background: var(--gradient-brand);
    opacity: 0.22;
    filter: blur(40px);
  }

  .media-frame,
  .product-media {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-sunken);
    box-shadow: var(--shadow-lg);
  }

  .hero-media .media-frame {
    transform: rotate(1.5deg);
  }

  .media-frame img,
  .product-media img {
    width: 100%;
    height: auto;
  }

  .hero-media figcaption {
    margin-top: var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
    text-align: right;
  }

  .hero-orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--color-primary) 18%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-orbit--one {
    top: 3%;
    right: -8rem;
    width: 28rem;
    height: 28rem;
  }

  .hero-orbit--two {
    right: 4%;
    bottom: -12rem;
    width: 36rem;
    height: 36rem;
  }

  .studio-story {
    background: var(--color-surface);
  }

  .story-intro,
  .workflow-heading,
  .pricing-heading {
    max-width: 46rem;
  }

  .story-intro h2,
  .workflow-heading h2,
  .pricing-heading h2,
  .faq-heading h2,
  .open-lead h2 {
    font-size: clamp(2.25rem, 5vw, 4rem);
    text-wrap: balance;
  }

  .story-intro p,
  .workflow-heading p,
  .pricing-heading p,
  .faq-heading p,
  .open-lead p {
    max-width: 38rem;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .story-line {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-top: clamp(var(--space-10), 6vw, var(--space-16));
  }

  .story-line article {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-strong);
  }

  .story-icon,
  .section-symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary-text);
  }

  .story-line h3,
  .format-panel h3 {
    font-size: var(--font-size-xl);
  }

  .story-line p,
  .format-panel p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .ai-story {
    position: relative;
  }

  .ai-story::before {
    content: '';
    position: absolute;
    inset: 12% 0 18% 42%;
    z-index: -1;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 10%, transparent),
      color-mix(in srgb, var(--color-accent) 8%, transparent)
    );
  }

  .product-media {
    margin: 0;
  }

  .product-media--ai {
    transform: rotate(-1deg);
  }

  .ai-copy {
    max-width: 31rem;
  }

  .ai-copy h2 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    text-wrap: balance;
  }

  .ai-copy > p {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    color: var(--color-primary-text);
    font-family: var(--font-display);
    font-weight: var(--font-weight-semibold);
  }

  .text-link:hover span {
    transform: translateX(0.25rem);
  }

  .text-link span {
    transition: transform var(--duration-fast) var(--ease-emphasized);
  }

  .workflow {
    background: var(--color-surface-sunken);
  }

  .workflow-grid {
    margin-top: clamp(var(--space-10), 6vw, var(--space-16));
    align-items: stretch;
  }

  .product-media--mix {
    min-height: 22rem;
  }

  .product-media--mix img {
    height: 100%;
    object-fit: cover;
  }

  .format-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(var(--space-6), 5vw, var(--space-10));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .format-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding: 0;
    list-style: none;
  }

  .format-list li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .open-grid {
    align-items: start;
  }

  .open-lead {
    position: sticky;
    top: 7rem;
  }

  .open-paths {
    display: grid;
    gap: var(--space-4);
  }

  .open-paths a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: clamp(var(--space-6), 5vw, var(--space-8));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    transition:
      border-color var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-emphasized);
  }

  .open-paths a:hover {
    border-color: var(--color-primary);
    text-decoration: none;
    transform: translateX(0.25rem);
  }

  .open-paths strong {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
  }

  .open-paths span:first-child {
    max-width: 42rem;
    color: var(--color-text-muted);
  }

  .open-paths strong,
  .open-paths span:last-child {
    color: var(--color-text);
  }

  .pricing-story {
    background: var(--color-surface);
  }

  .plans-grid {
    margin-top: clamp(var(--space-10), 6vw, var(--space-16));
    align-items: stretch;
  }

  .plan-card {
    padding: clamp(var(--space-6), 5vw, var(--space-10));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .plan-card--pro {
    border-color: color-mix(in srgb, var(--color-primary) 55%, var(--color-border));
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-primary) 10%, var(--color-surface-raised)),
        var(--color-surface-raised) 65%
      );
    box-shadow: var(--shadow-md);
  }

  .plan-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .plan-heading h3 {
    font-size: var(--font-size-2xl);
  }

  .plan-price {
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
    text-align: right;
  }

  .plan-price span {
    display: block;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
  }

  .plan-description {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .plan-card ul {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding: 0;
    list-style: none;
  }

  .plan-card li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-text-muted);
  }

  .plan-card li svg {
    flex: none;
    margin-top: 0.2em;
    color: var(--color-accent-text);
  }

  .pricing-note {
    margin-top: var(--space-6);
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
  }

  .faq-grid {
    align-items: start;
  }

  .faq-list details {
    border-bottom: 1px solid var(--color-border);
  }

  .faq-list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-6);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list p {
    max-width: 42rem;
    padding: 0 var(--space-10) var(--space-6) 0;
    color: var(--color-text-muted);
  }

  .faq-plus {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    transition: transform var(--duration-base) var(--ease-emphasized);
  }

  details[open] .faq-plus {
    transform: rotate(45deg);
  }

  .download-story {
    padding-top: var(--space-8);
  }

  .download-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-8);
    padding: clamp(var(--space-8), 7vw, var(--space-16));
    border-radius: var(--radius-xl);
    background: var(--gradient-brand);
    box-shadow: var(--shadow-lg);
  }

  .download-panel h2 {
    max-width: 13ch;
    color: var(--color-neutral-0);
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    text-wrap: balance;
  }

  .download-panel p {
    max-width: 34rem;
    margin-top: var(--space-4);
    color: color-mix(in srgb, var(--color-neutral-0) 90%, transparent);
    font-size: var(--font-size-lg);
  }

  .download-actions {
    margin-top: 0;
