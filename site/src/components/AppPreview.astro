---
/**
 * Zero-JS product preview for the hero — a stylised Cadence composer window
 * (piano-roll notes, a sweeping playhead, transport + a small visualiser).
 *
 * Pure SVG/CSS built entirely from the brand tokens (tokens.css); no new colors
 * are introduced. Decorative only (aria-hidden) — the surrounding hero copy
 * carries the meaning. All motion is wrapped in `prefers-reduced-motion:
 * no-preference`, so reduced-motion users get a static still.
 */

// Lanes (top -> bottom) and the note blocks that sit on them. Positions are
// percentages of the roll width so the layout scales fluidly with no overflow.
const lanes = ['Keys', 'Bass', 'Drums', 'Synth'] as const;

type Note = { lane: number; x: number; w: number; tone: 'v' | 'b' | 'c' };
const notes: Note[] = [
  { lane: 0, x: 4, w: 16, tone: 'v' },
  { lane: 0, x: 24, w: 10, tone: 'v' },
  { lane: 0, x: 52, w: 20, tone: 'c' },
  { lane: 0, x: 78, w: 14, tone: 'v' },
  { lane: 1, x: 6, w: 26, tone: 'b' },
  { lane: 1, x: 40, w: 12, tone: 'b' },
  { lane: 1, x: 68, w: 24, tone: 'b' },
  { lane: 2, x: 4, w: 8, tone: 'c' },
  { lane: 2, x: 20, w: 8, tone: 'c' },
  { lane: 2, x: 36, w: 8, tone: 'c' },
  { lane: 2, x: 60, w: 8, tone: 'c' },
  { lane: 2, x: 82, w: 8, tone: 'c' },
  { lane: 3, x: 12, w: 18, tone: 'v' },
  { lane: 3, x: 46, w: 30, tone: 'b' },
  { lane: 3, x: 84, w: 10, tone: 'c' },
];
---

<div class="app-preview" aria-hidden="true">
  <div class="app-window">
    <div class="app-titlebar">
      <span class="app-dots"><i></i><i></i><i></i></span>
      <span class="app-file">untitled.cadence</span>
      <span class="app-chip">120 BPM · 4/4</span>
    </div>

    <div class="app-roll">
      <div class="roll-lanes">
        {
          lanes.map((lane, i) => (
            <div class="lane">
              <span class="lane-label">{lane}</span>
              <div class="lane-track">
                {notes
                  .filter((n) => n.lane === i)
                  .map((n) => (
                    <span
                      class={`note note-${n.tone}`}
                      style={`left:${n.x}%;width:${n.w}%`}
                    />
                  ))}
              </div>
            </div>
          ))
        }
      </div>
      <span class="playhead"></span>
    </div>

    <div class="app-transport">
      <span class="transport-controls">
        <i class="ctl-play"></i>
        <i class="ctl-stop"></i>
      </span>
      <span class="app-time">00:00 · 001.1.1</span>
      <span class="eq">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
    </div>
  </div>
</div>

<style>
  .app-preview {
    position: relative;
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
  }

  /* Soft brand glow behind the window (decorative). */
  .app-preview::before {
    content: '';
    position: absolute;
    inset: -12% -6% 0;
    background: var(--gradient-brand);
    opacity: 0.22;
    filter: blur(48px);
    border-radius: var(--radius-xl);
    z-index: -1;
  }

  .app-window {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    text-align: left;
  }

  /* -------------------------------------------------------- Title bar */
  .app-titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .app-dots {
    display: inline-flex;
    gap: var(--space-2);
  }

  .app-dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--color-border-strong);
  }

  .app-dots i:nth-child(1) {
    background: var(--color-violet-500);
  }
  .app-dots i:nth-child(2) {
    background: var(--color-blue-500);
  }
  .app-dots i:nth-child(3) {
    background: var(--color-cyan-400);
  }

  .app-file {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .app-chip {
    margin-left: auto;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary-text);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    white-space: nowrap;
  }

  /* --------------------------------------------------------- Piano roll */
  .app-roll {
    position: relative;
    padding: var(--space-4);
    /* Faint vertical beat grid built from a token color. */
    background-image: repeating-linear-gradient(
      to right,
      color-mix(in srgb, var(--color-border) 60%, transparent) 0,
      color-mix(in srgb, var(--color-border) 60%, transparent) 1px,
      transparent 1px,
      transparent 12.5%
    );
    overflow: hidden;
  }

  .roll-lanes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .lane {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .lane-label {
    flex: none;
    width: 3.25rem;
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .lane-track {
    position: relative;
    flex: 1;
    height: 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface-sunken);
  }

  .note {
    position: absolute;
    top: 0.2rem;
    bottom: 0.2rem;
    border-radius: var(--radius-sm);
    opacity: 0.92;
  }

  .note-v {
    background: var(--color-violet-500);
  }
  .note-b {
    background: var(--color-blue-500);
  }
  .note-c {
    background: var(--color-cyan-500);
  }

  .playhead {
    position: absolute;
    top: var(--space-2);
    bottom: var(--space-2);
    left: 12%;
    width: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-text);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-accent) 40%, transparent);
  }

  /* --------------------------------------------------------- Transport */
  .app-transport {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .transport-controls {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .ctl-play {
    width: 0;
    height: 0;
    border-top: 0.4rem solid transparent;
    border-bottom: 0.4rem solid transparent;
    border-left: 0.7rem solid var(--color-primary-text);
  }

  .ctl-stop {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    background: var(--color-text-subtle);
  }

  .app-time {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    margin-left: auto;
    height: 1.25rem;
  }

  .eq i {
    width: 3px;
    height: 40%;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    transform-origin: bottom;
  }

  /* ------------------------------------------------------------- Motion */
  @media (prefers-reduced-motion: no-preference) {
    .playhead {
      animation: playhead-sweep 5s var(--ease-standard) infinite;
    }

    .eq i {
      animation: eq-bounce 1.1s var(--ease-standard) infinite;
    }
    .eq i:nth-child(1) { animation-delay: 0ms; }
    .eq i:nth-child(2) { animation-delay: 120ms; }
    .eq i:nth-child(3) { animation-delay: 240ms; }
    .eq i:nth-child(4) { animation-delay: 360ms; }
    .eq i:nth-child(5) { animation-delay: 180ms; }
    .eq i:nth-child(6) { animation-delay: 300ms; }
    .eq i:nth-child(7) { animation-delay: 60ms; }
  }

  @keyframes playhead-sweep {
    0% { left: 8%; }
    50% { left: 92%; }
    100% { left: 8%; }
  }

  @keyframes eq-bounce {
    0%, 100% { height: 30%; }
    50% { height: 100%; }
  }
</style>
