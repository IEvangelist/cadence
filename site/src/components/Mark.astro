<style>
  .wave,
  .tonic-dot {
    transform-box: fill-box;
    transform-origin: center;
  }

  .is-animated .wave {
    animation: cadence-wave-breathe 2.4s var(--ease-standard) infinite;
  }

  .is-animated .wave-2 {
    animation-delay: 50ms;
  }

  .is-animated .wave-3 {
    animation-delay: 100ms;
  }

  .is-animated .playhead {
    opacity: 0;
    stroke-dasharray: 0.09 1;
    stroke-dashoffset: 1;
    animation: cadence-playhead 2.4s linear infinite;
  }

  .is-animated .playhead-2 {
    animation-delay: 50ms;
  }

  .is-animated .playhead-3 {
    animation-delay: 100ms;
  }

  .is-animated .tonic-dot {
    animation: cadence-tonic-resolve 2.4s var(--ease-spring) infinite;
  }

  @keyframes cadence-wave-breathe {
    0%,
    100% {
      opacity: 1;
      transform: scaleY(1);
    }
    24% {
      opacity: 0.86;
      transform: scaleY(0.985);
    }
    52% {
      opacity: 1;
      transform: scaleY(1.025);
    }
    76% {
      opacity: 0.94;
      transform: scaleY(0.995);
    }
  }

  @keyframes cadence-playhead {
    0% {
      opacity: 0;
      stroke-dashoffset: 1;
    }
    10% {
      opacity: 0.32;
    }
    72% {
      opacity: 0.26;
      stroke-dashoffset: 0.05;
    }
    84%,
    100% {
      opacity: 0;
      stroke-dashoffset: -0.12;
    }
  }

  @keyframes cadence-tonic-resolve {
    0%,
    70%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    78% {
      opacity: 0.86;
      transform: scale(0.92);
    }
    86% {
      opacity: 1;
      transform: scale(1.22);
    }
    94% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .is-animated .wave,
    .is-animated .tonic-dot,
    .is-animated .playhead {
      animation: none !important;
      transform: none;
    }

    .is-animated .wave,
    .is-animated .tonic-dot {
      opacity: 1;
    }

    .is-animated .playhead {
      opacity: 0;
    }
  }
</style>
