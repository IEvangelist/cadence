---
/**
 * Cadence "Harmonic Waves" logomark — inlined from docs/brand/logo/logomark.svg
 * (brand source of truth). Three gradient waves resolving to the cyan tonic dot.
 *
 * Gradient IDs are namespaced by `id` so multiple marks can coexist on one page
 * without duplicate-id collisions.
 */
interface Props {
  id?: string;
  class?: string;
  title?: string; // when set, the mark is exposed as an image with this label
  animated?: boolean;
}
const { id = 'mark', class: className, title, animated = false } = Astro.props;
const classes = [className, animated && 'is-animated'].filter(Boolean).join(' ');
const a11y = title
  ? { role: 'img', 'aria-label': title }
  : { 'aria-hidden': 'true' as const };
